# Copy this file to .env for local testing (docker-compose reads it automatically).
# In AWS/Azure, set these as secrets/environment variables on the service instead
# of shipping a .env file inside the image.

# Required: your organization's Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: port the server listens on. Defaults to 8080.
PORT=8080

# How users sign in:
#   basic (default, for local runs) - one shared login, set AUTH_USERNAME/AUTH_PASSWORD below.
#   entra - for Azure Container Apps with built-in authentication (Microsoft Entra ID)
#           turned on and "Require authentication" set. The app then trusts the identity
#           Azure forwards, so leave AUTH_USERNAME/AUTH_PASSWORD unset and list admins below.
AUTH_MODE=basic
AUTH_USERNAME=
AUTH_PASSWORD=

# Comma-separated sign-in emails (UPN) of the admins. Used when AUTH_MODE=entra;
# everyone else who can sign in is a regular user.
ADMIN_EMAILS=
